@page "/calendar"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Senior_Design_Pet_Care_App.Data
@using Senior_Design_Pet_Care_App.Entities
@using Senior_Design_Pet_Care_App.Services
@inject ApplicationDbContext Db
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

@attribute [Authorize]

<h3>Calendar</h3>

<div class="calendar-container">
    <div class="calendar-header mb-2 d-flex align-items-center">
        <button class="btn btn-sm btn-secondary me-2" @onclick="PreviousMonth">←</button>
        <strong class="me-2">@CurrentMonth.ToString("MMMM yyyy")</strong>
        <button class="btn btn-sm btn-secondary" @onclick="NextMonth">→</button>

        <button class="btn btn-sm btn-primary ms-auto" @onclick="OpenAddForm">
            + Add Event
        </button>
    </div>

    <div class="calendar-grid">
        @foreach (var dayName in DayNames)
        {
            <div class="calendar-day-header">@dayName</div>
        }

        @for (int i = 0; i < FirstDayOffset; i++)
        {
            <div class="calendar-day empty"></div>
        }

        @for (int day = 1; day <= DaysInMonth; day++)
        {
            var date = new DateTime(CurrentMonth.Year, CurrentMonth.Month, day);
            <div class="calendar-day" @onclick="() => GoToDay(date)">
                <div class="date-number">@day</div>

                @if (Events.TryGetValue(date.Date, out var list))
                {
                    foreach (var ev in list.OrderBy(r => r.RemindAt.TimeOfDay))
                    {
                        <div class="event" title="@ev.Description">
                            @ev.Title
                            @(ev.Pet != null ? $" ({ev.Pet.Name})" : "")
                            @(ev.SeriesId.HasValue ? " ↻" : "")
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@if (ShowForm)
{
    <div class="modal d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Event</h5>
                    <button type="button" class="btn-close" @onclick="CancelForm"></button>
                </div>
                <div class="modal-body">
                    <label>Title</label>
                    <input class="form-control mb-2" @bind="FormTitle" placeholder="e.g. Vet Visit" />

                    <div class="row">
                        <div class="col">
                            <label>Date</label>
                            <input type="date" class="form-control mb-2" @bind="FormDate" />
                        </div>
                        <div class="col">
                            <label>Time</label>
                            <input type="time" class="form-control mb-2" @bind="FormTime" />
                        </div>
                    </div>

                    <label>Event Type</label>
                    <select class="form-control mb-2" @bind="FormTypeString">
                        @foreach (ReminderType t in Enum.GetValues(typeof(ReminderType)))
                        {
                            <option value="@t">@t.ToString()</option>
                        }
                    </select>

                    <label>Pet</label>
                    <select class="form-control mb-2" @bind="FormPetIdString">
                        <option value="">N/A (No Pet)</option>
                        @foreach (var pet in UserPets)
                        {
                            <option value="@pet.Id">@pet.Name</option>
                        }
                    </select>

                    <label>Recurrence</label>
                    <select class="form-control mb-2" @bind="FormRecurrenceString">
                        @foreach (RecurrenceType r in Enum.GetValues(typeof(RecurrenceType)))
                        {
                            <option value="@r">@r.ToString()</option>
                        }
                    </select>

                    @if (FormRecurrenceString != RecurrenceType.None.ToString())
                    {
                        <label>Repeat Until</label>
                        <input type="date" class="form-control mb-2" @bind="FormRecurrenceEndDate" />
                    }

                    <label>Description</label>
                    <textarea class="form-control mb-2" rows="2" @bind="FormDescription"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
                    <button class="btn btn-success" @onclick="SaveEvent">Save Event</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime CurrentMonth { get; set; } = DateTime.Today;
    private Dictionary<DateTime, List<Reminder>> Events { get; set; } = new();
    private List<Pet> UserPets { get; set; } = new();
    private string[] DayNames = CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;
    private int DaysInMonth => DateTime.DaysInMonth(CurrentMonth.Year, CurrentMonth.Month);
    private int FirstDayOffset => (int)new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1).DayOfWeek;

    // --- Form State Variables ---
    private bool ShowForm = false;
    private string FormTitle = string.Empty;
    private string FormDescription = string.Empty;
    private DateTime FormDate = DateTime.Today;
    private TimeOnly FormTime = TimeOnly.FromDateTime(DateTime.Now);
    private string FormTypeString = ReminderType.Other.ToString();
    private string FormPetIdString = string.Empty;
    private string FormRecurrenceString = RecurrenceType.None.ToString();
    private DateTime FormRecurrenceEndDate = DateTime.Today.AddMonths(1);

    protected override async Task OnInitializedAsync()
    {
        await LoadUserPetsAsync();
        await LoadUserRemindersAsync();
    }

    private async Task PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        await LoadUserRemindersAsync();
    }

    private async Task NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        await LoadUserRemindersAsync();
    }

    private void GoToDay(DateTime date)
    {
        var dayString = date.ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/dailyreminders/{dayString}");
    }

    private async Task LoadUserPetsAsync()
    {
        var email = AuthService.CurrentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
                    ?? AuthService.CurrentUser?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(email)) return;

        var user = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());
        if (user == null) return;

        UserPets = await Db.Pets.AsNoTracking().Where(p => p.UserId == user.Id).ToListAsync();
    }

    private async Task LoadUserRemindersAsync()
    {
        Events.Clear();

        var email = AuthService.CurrentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
                    ?? AuthService.CurrentUser?.Identity?.Name;

        if (string.IsNullOrWhiteSpace(email)) return;

        var user = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());
        if (user == null) return;

        var startOfMonth = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var endOfMonth = startOfMonth.AddMonths(1).AddDays(-1);

        var reminders = await Db.Reminders
            .Include(r => r.Pet) // Load the linked Pet object
            .AsNoTracking()
            .Where(r => r.UserId == user.Id && r.RemindAt >= startOfMonth && r.RemindAt <= endOfMonth.AddDays(1))
            .ToListAsync();

        foreach (var r in reminders)
        {
            var key = r.RemindAt.Date;
            if (!Events.ContainsKey(key)) Events[key] = new List<Reminder>();
            Events[key].Add(r);
        }
    }

    private void OpenAddForm()
    {
        FormTitle = "";
        FormDescription = "";
        FormDate = DateTime.Today;
        FormTime = TimeOnly.FromDateTime(DateTime.Now);
        FormTypeString = ReminderType.Other.ToString();
        FormPetIdString = "";
        FormRecurrenceString = RecurrenceType.None.ToString();
        FormRecurrenceEndDate = DateTime.Today.AddMonths(1);
        ShowForm = true;
    }

    private void CancelForm() => ShowForm = false;

    private async Task SaveEvent()
    {
        var email = AuthService.CurrentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
                    ?? AuthService.CurrentUser?.Identity?.Name;

        if (string.IsNullOrWhiteSpace(email)) return;

        var user = await Db.Users.FirstAsync(u => u.Email.ToLower() == email.ToLower());

        Enum.TryParse(FormTypeString, out ReminderType parsedType);
        Enum.TryParse(FormRecurrenceString, out RecurrenceType parsedRecurrence);

        int? parsedPetId = string.IsNullOrEmpty(FormPetIdString) ? null : int.Parse(FormPetIdString);

        var baseTime = FormTime.ToTimeSpan();
        var currentDate = FormDate.Date;
        var endDate = parsedRecurrence == RecurrenceType.None ? currentDate : FormRecurrenceEndDate.Date;

        if (endDate > currentDate.AddYears(5)) endDate = currentDate.AddYears(5);

        var seriesId = parsedRecurrence != RecurrenceType.None ? Guid.NewGuid() : (Guid?)null;
        var remindersToInsert = new List<Reminder>();

        while (currentDate <= endDate)
        {
            remindersToInsert.Add(new Reminder
            {
                UserId = user.Id,
                PetId = parsedPetId,
                Title = FormTitle,
                Description = string.IsNullOrWhiteSpace(FormDescription) ? null : FormDescription,
                RemindAt = currentDate + baseTime,
                Type = parsedType,
                SeriesId = seriesId
            });

            currentDate = parsedRecurrence switch
            {
                RecurrenceType.Daily => currentDate.AddDays(1),
                RecurrenceType.Weekly => currentDate.AddDays(7),
                RecurrenceType.Monthly => currentDate.AddMonths(1),
                RecurrenceType.Yearly => currentDate.AddYears(1),
                _ => DateTime.MaxValue
            };
        }

        Db.Reminders.AddRange(remindersToInsert);
        await Db.SaveChangesAsync();

        await LoadUserRemindersAsync();
        ShowForm = false;
    }
}