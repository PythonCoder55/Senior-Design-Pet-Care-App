@page "/dailyreminders/{dateString}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Senior_Design_Pet_Care_App.Data
@using Senior_Design_Pet_Care_App.Entities
@using Senior_Design_Pet_Care_App.Services

@attribute [Authorize]
@inject ApplicationDbContext Db
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Pet Care Companion</PageTitle>

<h3>Reminders for @SelectedDate.ToString("D")</h3>

@if (Reminders == null)
{
    <p>Loading reminders...</p>
}
else if (Reminders.Count == 0)
{
    <div class="alert alert-info">
        No reminders for this day. Click "Add Reminder" to create one.
    </div>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var reminder in Reminders.OrderBy(r => r.RemindAt.TimeOfDay))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-action"
                style="cursor: pointer;"
                @onclick="() => SelectReminder(reminder)">

                <div>
                    <strong>@reminder.RemindAt.ToString("t")</strong>
                    <span class="ms-2">@reminder.Title</span>

                    @if (reminder.Pet != null)
                    {
                        <span class="badge bg-primary ms-2"><i class="bi bi-suit-heart-fill me-1"></i>@reminder.Pet.Name</span>
                    }

                    <span class="badge bg-secondary ms-2">@reminder.Type</span>

                    @if (reminder.SeriesId.HasValue)
                    {
                        <span class="badge bg-info ms-2" title="Recurring Event">↻</span>
                    }
                </div>
                <span class="text-muted small">Edit</span>
            </li>
        }
    </ul>
}

<div class="mt-3">
    <button class="btn btn-primary" @onclick="ShowAddForm">Add Reminder</button>
    <button class="btn btn-secondary ms-2" @onclick="GoBack">Back to Calendar</button>
</div>

@if (ShowForm)
{
    <div class="modal d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(EditingReminder == null ? "Add Reminder" : "Edit Reminder")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-2 text-muted small">
                        Date: @SelectedDate.ToString("D")
                    </div>

                    <label>Title</label>
                    <input class="form-control mb-2" @bind="FormTitle" placeholder="Walk, Meds, etc." />

                    <label>Time</label>
                    <input type="time" class="form-control mb-2" @bind="FormTime" />

                    <label>Event Type</label>
                    <select class="form-control mb-2" @bind="FormTypeString">
                        @foreach (ReminderType t in Enum.GetValues(typeof(ReminderType)))
                        {
                            <option value="@t">@t.ToString()</option>
                        }
                    </select>

                    <label>Pet</label>
                    <select class="form-control mb-2" @bind="FormPetIdString">
                        <option value="">N/A (No Pet)</option>
                        @foreach (var pet in UserPets)
                        {
                            <option value="@pet.Id">@pet.Name</option>
                        }
                    </select>

                    @if (EditingReminder == null)
                    {
                        <label>Recurrence</label>
                        <select class="form-control mb-2" @bind="FormRecurrenceString">
                            @foreach (RecurrenceType r in Enum.GetValues(typeof(RecurrenceType)))
                            {
                                <option value="@r">@r.ToString()</option>
                            }
                        </select>

                        @if (FormRecurrenceString != RecurrenceType.None.ToString())
                        {
                            <label>Repeat Until</label>
                            <input type="date" class="form-control mb-2" @bind="FormRecurrenceEndDate" />
                        }
                    }
                    else if (EditingReminder.SeriesId.HasValue)
                    {
                        <div class="form-check mt-3 mb-2 p-3 bg-light border rounded">
                            <input class="form-check-input ms-1" type="checkbox" id="updateSeriesCheck" @bind="ApplyToEntireSeries">
                            <label class="form-check-label ms-4 fw-bold text-primary" for="updateSeriesCheck">
                                Apply Edit/Delete to all future occurrences in this series?
                            </label>
                        </div>
                    }

                    <label>Description</label>
                    <textarea class="form-control mb-2" rows="2" @bind="FormDescription"></textarea>
                </div>

                <div class="modal-footer">
                    @if (EditingReminder == null)
                    {
                        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                        <button class="btn btn-success" @onclick="AddReminder">Add</button>
                    }
                    else
                    {
                        <button class="btn btn-danger me-auto" @onclick="DeleteReminder">Delete</button>
                        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                        <button class="btn btn-success" @onclick="UpdateReminder">Save Changes</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string dateString { get; set; } = string.Empty;
    private DateTime SelectedDate;
    private List<Reminder> Reminders = new();
    private List<Pet> UserPets = new();

    private bool ShowForm = false;
    private Reminder? EditingReminder;

    private string FormTitle = string.Empty;
    private string FormDescription = string.Empty;
    private TimeOnly FormTime = TimeOnly.FromDateTime(DateTime.Now);
    private string FormTypeString = ReminderType.Other.ToString();
    private string FormPetIdString = string.Empty;

    // Recurrence / Series logic
    private string FormRecurrenceString = RecurrenceType.None.ToString();
    private DateTime FormRecurrenceEndDate = DateTime.Today.AddMonths(1);
    private bool ApplyToEntireSeries = false;

    protected override async Task OnInitializedAsync()
    {
        if (DateTime.TryParse(dateString, out var parsedDate))
        {
            SelectedDate = parsedDate;
        }
        else
        {
            SelectedDate = DateTime.Today;
        }
        await LoadUserPetsAsync();
        await LoadRemindersAsync();
    }

    private async Task LoadUserPetsAsync()
    {
        var email = AuthService.CurrentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
                    ?? AuthService.CurrentUser?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(email)) return;

        var user = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());
        if (user == null) return;

        UserPets = await Db.Pets.AsNoTracking().Where(p => p.UserId == user.Id).ToListAsync();
    }

    private async Task LoadRemindersAsync()
    {
        var email = AuthService.CurrentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
                    ?? AuthService.CurrentUser?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(email)) return;

        var user = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());
        if (user == null) return;

        Reminders = await Db.Reminders
            .Include(r => r.Pet)
            .AsNoTracking()
            .Where(r => r.UserId == user.Id && r.RemindAt.Date == SelectedDate.Date)
            .OrderBy(r => r.RemindAt)
            .ToListAsync();
    }

    private void ShowAddForm()
    {
        EditingReminder = null;
        FormTitle = "";
        FormDescription = "";
        FormTime = TimeOnly.FromDateTime(DateTime.Now);
        FormTypeString = ReminderType.Other.ToString();
        FormPetIdString = "";
        FormRecurrenceString = RecurrenceType.None.ToString();
        FormRecurrenceEndDate = SelectedDate.AddMonths(1);
        ApplyToEntireSeries = false;
        ShowForm = true;
    }

    private void SelectReminder(Reminder reminder)
    {
        EditingReminder = reminder;
        FormTitle = reminder.Title;
        FormDescription = reminder.Description ?? "";
        FormTime = TimeOnly.FromDateTime(reminder.RemindAt);
        FormTypeString = reminder.Type.ToString();
        FormPetIdString = reminder.PetId?.ToString() ?? "";
        ApplyToEntireSeries = false; // default to false
        ShowForm = true;
    }

    private async Task AddReminder()
    {
        var email = AuthService.CurrentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
                    ?? AuthService.CurrentUser?.Identity?.Name;

        var user = await Db.Users.FirstAsync(u => u.Email.ToLower() == email.ToLower());

        Enum.TryParse(FormTypeString, out ReminderType parsedType);
        Enum.TryParse(FormRecurrenceString, out RecurrenceType parsedRecurrence);

        int? parsedPetId = string.IsNullOrEmpty(FormPetIdString) ? null : int.Parse(FormPetIdString);

        var baseTime = FormTime.ToTimeSpan();
        var currentDate = SelectedDate.Date;
        var endDate = parsedRecurrence == RecurrenceType.None ? currentDate : FormRecurrenceEndDate.Date;
        if (endDate > currentDate.AddYears(5)) endDate = currentDate.AddYears(5);

        var seriesId = parsedRecurrence != RecurrenceType.None ? Guid.NewGuid() : (Guid?)null;
        var remindersToInsert = new List<Reminder>();

        while (currentDate <= endDate)
        {
            remindersToInsert.Add(new Reminder
            {
                UserId = user.Id,
                PetId = parsedPetId,
                Title = FormTitle,
                Description = string.IsNullOrWhiteSpace(FormDescription) ? null : FormDescription,
                RemindAt = currentDate + baseTime,
                Type = parsedType,
                SeriesId = seriesId
            });

            currentDate = parsedRecurrence switch
            {
                RecurrenceType.Daily => currentDate.AddDays(1),
                RecurrenceType.Weekly => currentDate.AddDays(7),
                RecurrenceType.Monthly => currentDate.AddMonths(1),
                RecurrenceType.Yearly => currentDate.AddYears(1),
                _ => DateTime.MaxValue
            };
        }

        Db.Reminders.AddRange(remindersToInsert);
        await Db.SaveChangesAsync();

        await LoadRemindersAsync();
        ShowForm = false;
    }

    private async Task UpdateReminder()
    {
        if (EditingReminder == null) return;

        Enum.TryParse(FormTypeString, out ReminderType parsedType);
        int? parsedPetId = string.IsNullOrEmpty(FormPetIdString) ? null : int.Parse(FormPetIdString);

        if (ApplyToEntireSeries && EditingReminder.SeriesId.HasValue)
        {
            var seriesItems = await Db.Reminders
                .Where(r => r.SeriesId == EditingReminder.SeriesId.Value && r.RemindAt.Date >= SelectedDate.Date)
                .ToListAsync();

            foreach (var item in seriesItems)
            {
                item.Title = FormTitle;
                item.Description = string.IsNullOrWhiteSpace(FormDescription) ? null : FormDescription;
                item.Type = parsedType;
                item.PetId = parsedPetId;
                item.RemindAt = item.RemindAt.Date + FormTime.ToTimeSpan();
            }
        }
        else
        {
            var trackedReminder = await Db.Reminders.FindAsync(EditingReminder.Id);

            if (trackedReminder != null)
            {
                trackedReminder.Title = FormTitle;
                trackedReminder.Description = string.IsNullOrWhiteSpace(FormDescription) ? null : FormDescription;
                trackedReminder.RemindAt = SelectedDate.Date + FormTime.ToTimeSpan();
                trackedReminder.Type = parsedType;
                trackedReminder.PetId = parsedPetId;
            }
        }

        await Db.SaveChangesAsync();
        await LoadRemindersAsync();
        ShowForm = false;
    }

    private async Task DeleteReminder()
    {
        if (EditingReminder == null) return;

        if (ApplyToEntireSeries && EditingReminder.SeriesId.HasValue)
        {
            var seriesItems = await Db.Reminders
                .Where(r => r.SeriesId == EditingReminder.SeriesId.Value && r.RemindAt.Date >= SelectedDate.Date)
                .ToListAsync();
            Db.Reminders.RemoveRange(seriesItems);
        }
        else
        {
            var trackedReminder = await Db.Reminders.FindAsync(EditingReminder.Id);

            if (trackedReminder != null)
            {
                Db.Reminders.Remove(trackedReminder);
            }
        }

        await Db.SaveChangesAsync();
        await LoadRemindersAsync();
        ShowForm = false;
    }

    private void CancelEdit() => ShowForm = false;
    private void GoBack() => NavigationManager.NavigateTo("/calendar");
}